# OpenSeek-SM Docker deployment settings
OPENSEEK_IMAGE=ghcr.io/liberseek/openseek-sm-ce
OPENSEEK_VERSION=v0.0.1
PORT=4007
MAIN_URL=http://localhost:4007
FRONTEND_URL=http://localhost:4007
NEXT_PUBLIC_BACKEND_URL=http://localhost:4007/api
# Use false when MAIN_URL is served over HTTPS.
NOT_SECURED=true

# Replace this before the first start. Keep it stable across upgrades.
JWT_SECRET=change-me-to-a-long-random-value

# Optional provider and AI settings can be copied from .env.example.
# RSSHUB_BASE_URL=http://rsshub:1200
# RSSHUB_INTERNAL_TOKEN=
# OPENAI_API_KEY=
